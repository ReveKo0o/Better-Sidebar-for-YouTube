{
  "manifest_version": 2,
  "name": "Better Sidebar for YouTube",
  "version": "1.0",
  "description": "YouTube modern floating glass sidebar",
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "sidebar-bg.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": ["themeStyles.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "sidebar-bg.png"
  ]
}